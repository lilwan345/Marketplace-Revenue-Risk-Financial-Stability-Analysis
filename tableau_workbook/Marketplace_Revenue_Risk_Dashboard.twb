        <zone h='100000' id='1' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='5000' id='2' type='title' w='100000' x='0' y='0' />
          <zone h='56000' id='10' name='Revenue Share by State' show-title='true' w='52000' x='0' y='6000' />
          <zone h='56000' id='11' name='Customer Decile Revenue' show-title='true' w='46000' x='54000' y='6000' />
          <zone h='34000' id='12' name='Customer Lorenz Curve' show-title='true' w='100000' x='0' y='64000' />
        </zone>
      </zones>
    </dashboard>
    <dashboard name='Liquidity &amp; Action Plan'>
      <layout-options>
        <title><formatted-text>
          <run bold='true' fontcolor='#17212b' fontsize='16'>Liquidity &amp; Action Plan</run>
        </formatted-text></title>
      </layout-options>
      <size maxheight='850' maxwidth='1200' minheight='850' minwidth='1200' />
      <zones>
        <zone h='100000' id='1' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='5000' id='2' type='title' w='100000' x='0' y='0' />
          <zone h='43000' id='10' name='Payment Structure' show-title='true' w='48000' x='0' y='6000' />
          <zone h='43000' id='11' name='Installment Distribution' show-title='true' w='50000' x='50000' y='6000' />
          <zone h='46000' id='12' name='Action Plan' show-title='true' w='100000' x='0' y='52000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height='32'>
    <window class='dashboard' maximized='true' name='Liquidity &amp; Action Plan'><viewpoints><viewpoint name='Payment Structure' /><viewpoint name='Installment Distribution' /><viewpoint name='Action Plan' /></viewpoints><active id='-1' /></window>
    <window class='dashboard' maximized='true' name='Concentration Risk'><viewpoints><viewpoint name='Revenue Share by State' /><viewpoint name='Customer Decile Revenue' /><viewpoint name='Customer Lorenz Curve' /></viewpoints><active id='-1' /></window>
    <window class='dashboard' maximized='true' name='Revenue Stability'><viewpoints><viewpoint name='Monthly Revenue Trend' /><viewpoint name='MoM Growth' /></viewpoints><active id='-1' /></window>
    <window class='dashboard' maximized='true' name='Executive Risk Overview'><viewpoints><viewpoint name='KPI Cards' /><viewpoint name='Risk Priority Map' /><viewpoint name='Action Plan' /></viewpoints><active id='-1' /></window>
