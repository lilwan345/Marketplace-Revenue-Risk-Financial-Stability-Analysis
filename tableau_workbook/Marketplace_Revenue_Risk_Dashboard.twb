            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='None' name='[none:month:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Arial' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='mark'>
            <format attr='mark-labels-show' value='true' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
              <tooltip column='[monthly_revenue].[none:volatility_signal:nk]' />
            </encodings>
            <customized-tooltip show-buttons='false'><formatted-text /></customized-tooltip>
          </pane>
        </panes>
        <rows>[monthly_revenue].[sum:monthly_revenue:qk]</rows>
        <cols>[monthly_revenue].[month]</cols>
      </table>
    </worksheet>
