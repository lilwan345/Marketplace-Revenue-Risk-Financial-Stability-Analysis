  <worksheets>
    <worksheet name='KPI Cards'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17212b' fontsize='12'>Executive KPI Cards</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='kpi_summary' name='kpi_summary' />
          </datasources>
          <datasource-dependencies datasource='kpi_summary'>
            <column datatype='string' name='[risk_dimension]' role='dimension' type='nominal' />
            <column-instance column='[risk_dimension]' derivation='None' name='[none:risk_dimension:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Arial' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='mark'>
            <format attr='mark-labels-show' value='true' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings>
              <text column='[kpi_summary].[none:display_value:nk]' />
              <tooltip column='[kpi_summary].[none:client_explanation:nk]' />
              <tooltip column='[kpi_summary].[none:recommended_action:nk]' />
              <color column='[kpi_summary].[none:risk_level:nk]' />
            </encodings>
            <customized-tooltip show-buttons='false'><formatted-text /></customized-tooltip>
          </pane>
        </panes>
        <rows>[kpi_summary].[risk_dimension]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name='Risk Priority Map'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17212b' fontsize='12'>Risk Priority Map</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='kpi_summary' name='kpi_summary' />
          </datasources>
          <datasource-dependencies datasource='kpi_summary'>
            <column datatype='string' name='[risk_dimension]' role='dimension' type='nominal' />
            <column-instance column='[risk_dimension]' derivation='None' name='[none:risk_dimension:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Arial' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='mark'>
            <format attr='mark-labels-show' value='true' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
              <color column='[kpi_summary].[none:risk_level:nk]' />
              <text column='[kpi_summary].[sum:sort_order:qk]' />
            </encodings>
            <customized-tooltip show-buttons='false'><formatted-text /></customized-tooltip>
          </pane>
        </panes>
        <rows>[kpi_summary].[risk_dimension]</rows>
        <cols>[kpi_summary].[sum:sort_order:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Monthly Revenue Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17212b' fontsize='12'>Monthly Revenue Trend</run>
          </formatted-text>
