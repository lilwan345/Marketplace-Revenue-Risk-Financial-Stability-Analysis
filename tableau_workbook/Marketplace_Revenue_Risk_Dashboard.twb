  </preferences>
  <style-theme name='smooth' />
  <datasources>
    <datasource caption='kpi_summary' inline='true' name='kpi_summary' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='kpi_summary' name='kpi_summary_conn'>
            <connection class='textscan' directory='Data' filename='kpi_summary.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='kpi_summary_conn' name='kpi_summary.csv' table='[kpi_summary#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=',' text-qualifier='&quot;'>
            <column datatype='integer' name='sort_order' ordinal='0' />
            <column datatype='string' name='risk_dimension' ordinal='1' />
            <column datatype='string' name='kpi_name' ordinal='2' />
            <column datatype='real' name='kpi_value' ordinal='3' />
            <column datatype='string' name='display_value' ordinal='4' />
            <column datatype='string' name='risk_level' ordinal='5' />
            <column datatype='string' name='client_explanation' ordinal='6' />
            <column datatype='string' name='recommended_action' ordinal='7' />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class='capability'>
            <remote-name>Capabilities</remote-name>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column datatype='integer' name='[sort_order]' role='measure' type='quantitative' />
      <column datatype='string' name='[risk_dimension]' role='dimension' type='nominal' />
      <column datatype='string' name='[kpi_name]' role='dimension' type='nominal' />
      <column datatype='real' name='[kpi_value]' role='measure' type='quantitative' />
      <column datatype='string' name='[display_value]' role='dimension' type='nominal' />
      <column datatype='string' name='[risk_level]' role='dimension' type='nominal' />
      <column datatype='string' name='[client_explanation]' role='dimension' type='nominal' />
      <column datatype='string' name='[recommended_action]' role='dimension' type='nominal' />
    </datasource>
