          </style-rule>
        </style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings>
              <tooltip column='[customer_lorenz_curve].[sum:cumulative_revenue_share:qk]' />
            </encodings>
            <customized-tooltip show-buttons='false'><formatted-text /></customized-tooltip>
          </pane>
        </panes>
        <rows>[customer_lorenz_curve].[sum:cumulative_revenue_share:qk]</rows>
        <cols>[customer_lorenz_curve].[sum:cumulative_customer_share:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Payment Structure'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17212b' fontsize='12'>Revenue by Payment Structure</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='payment_summary' name='payment_summary' />
          </datasources>
          <datasource-dependencies datasource='payment_summary'>
            <column datatype='string' name='[payment_structure]' role='dimension' type='nominal' />
            <column-instance column='[payment_structure]' derivation='None' name='[none:payment_structure:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Arial' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='mark'>
            <format attr='mark-labels-show' value='true' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
              <color column='[payment_summary].[none:payment_structure:nk]' />
              <text column='[payment_summary].[sum:revenue_share:qk]' />
            </encodings>
            <customized-tooltip show-buttons='false'><formatted-text /></customized-tooltip>
          </pane>
        </panes>
        <rows>[payment_summary].[payment_structure]</rows>
        <cols>[payment_summary].[sum:revenue_share:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Installment Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17212b' fontsize='12'>Installment Count Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='installment_distribution' name='installment_distribution' />
          </datasources>
          <datasource-dependencies datasource='installment_distribution'>
            <column datatype='integer' name='[max_installments]' role='measure' type='quantitative' />
            <column-instance column='[max_installments]' derivation='Sum' name='[sum:max_installments:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Arial' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='mark'>
            <format attr='mark-labels-show' value='true' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
              <text column='[installment_distribution].[sum:revenue_share:qk]' />
            </encodings>
            <customized-tooltip show-buttons='false'><formatted-text /></customized-tooltip>
          </pane>
        </panes>
        <rows>[installment_distribution].[sum:revenue_share:qk]</rows>
        <cols>[installment_distribution].[max_installments]</cols>
      </table>
    </worksheet>
    <worksheet name='Action Plan'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#17212b' fontsize='12'>Recommended Management Actions</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='action_plan' name='action_plan' />
          </datasources>
          <datasource-dependencies datasource='action_plan'>
            <column datatype='integer' name='[priority]' role='measure' type='quantitative' />
            <column-instance column='[priority]' derivation='Sum' name='[sum:priority:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[action_area]' role='dimension' type='nominal' />
            <column-instance column='[action_area]' derivation='None' name='[none:action_area:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Arial' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='mark'>
            <format attr='mark-labels-show' value='true' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings>
              <text column='[action_plan].[none:suggested_intervention:nk]' />
              <tooltip column='[action_plan].[none:success_metric:nk]' />
            </encodings>
            <customized-tooltip show-buttons='false'><formatted-text /></customized-tooltip>
          </pane>
        </panes>
        <rows>[action_plan].[priority] / [action_plan].[action_area]</rows>
        <cols></cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Executive Risk Overview'>
      <layout-options>
        <title><formatted-text>
          <run bold='true' fontcolor='#17212b' fontsize='16'>Executive Risk Overview</run>
        </formatted-text></title>
      </layout-options>
      <size maxheight='850' maxwidth='1200' minheight='850' minwidth='1200' />
      <zones>
        <zone h='100000' id='1' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='5000' id='2' type='title' w='100000' x='0' y='0' />
          <zone h='33000' id='10' name='KPI Cards' show-title='true' w='100000' x='0' y='6000' />
          <zone h='57000' id='11' name='Risk Priority Map' show-title='true' w='56000' x='0' y='41000' />
          <zone h='57000' id='12' name='Action Plan' show-title='true' w='42000' x='58000' y='41000' />
        </zone>
      </zones>
    </dashboard>
    <dashboard name='Revenue Stability'>
      <layout-options>
